{
  "name": "clean99.github.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run assets && astro dev",
    "assets": "node scripts/build-images.mjs && node scripts/vendor.mjs",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "python3 scripts/optimize-fonts.py",
    "build": "pnpm run assets && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check . && node tools/social-growth/lint.mjs",
    "format": "prettier --write .",
    "test": "vitest run && node --test test/*.test.mjs",
    "test:unit": "vitest run",
    "test:tools": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:urls": "node scripts/check-legacy-urls.mjs",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "new:post": "node scripts/new-post.mjs",
    "verify": "pnpm run lint && pnpm run check && pnpm run test && pnpm run build && pnpm run test:urls && pnpm run test:e2e",
