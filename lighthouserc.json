{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4334/",
        "http://localhost:4334/zh/",
        "http://localhost:4334/2026/06/19/Designing-an-Operations-Heartbeat-System/",
        "http://localhost:4334/writing/",
        "http://localhost:4334/projects/",
        "http://localhost:4334/about/"
      ],
      "startServerCommand": "node scripts/serve-static.mjs --dist dist --port 4334",
      "startServerReadyPattern": "serve-static:",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
