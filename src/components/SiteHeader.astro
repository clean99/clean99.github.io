---
import SealMark from "./SealMark.astro";
import { HTML_LANG, localizePath, normalizePath, otherLang, t, type Lang } from "../lib/i18n";
import { counterpartPath, navItems, type Section } from "../lib/nav";
import { AUTHOR } from "../site.config";

export type { Section };

interface Props {
  lang: Lang;
  section?: Section | undefined;
  /** Same page in the other language; falls back to that language's home. */
  alternateHref?: string | undefined;
}

const { lang, section, alternateHref } = Astro.props;
const ui = t(lang);
const other = otherLang(lang);
const home = localizePath("/", lang);
const currentPath = normalizePath(Astro.url.pathname);

const nav = navItems({
  lang,
  path: currentPath,
  section,
  labels: { writing: ui.nav.writing, projects: ui.nav.projects, tags: ui.nav.tags, about: ui.nav.about }
}).map((item) => ({ ...item, current: item.href === currentPath ? "page" : item.current }));

const switchHref = counterpartPath(currentPath, other, alternateHref ? { [other]: alternateHref } : {});
const otherHome = localizePath("/", other);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home} aria-current={currentPath === home ? "page" : undefined}>
      <SealMark size={30} class="brand-seal" />
      <span class="brand-text">
        <span class="brand-name">{AUTHOR.name}</span>
        <span class="brand-tagline label">{ui.siteTagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label={ui.primaryNav}>
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-lang">
          <a
            class="lang-switch"
            href={switchHref ?? otherHome}
            hreflang={HTML_LANG[other]}
            lang={HTML_LANG[other]}
            title={ui.langSwitchLabel}
            data-astro-prefetch
          >
            {ui.langSwitch}
            <span class="visually-hidden"> — {ui.langSwitchLabel}</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="tools">
      <button
        class="tool search-trigger"
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K Meta+K /"
        aria-label={ui.search}
        title={ui.search}
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="m13 13 4.25 4.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <span class="search-label" aria-hidden="true">
          {ui.search}
        </span>
        <kbd class="search-kbd" aria-hidden="true">
          /
        </kbd>
      </button>

      <button
        class="tool theme-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={ui.theme}
        title={ui.theme}
      >
        <svg class="icon-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path
            d="M16.2 12.4A6.75 6.75 0 0 1 7.6 3.8a6.75 6.75 0 1 0 8.6 8.6Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          ></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="10" cy="10" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path
            d="M10 1.8v2.1M10 16.1v2.1M1.8 10h2.1M16.1 10h2.1M4.2 4.2l1.5 1.5M14.3 14.3l1.5 1.5M4.2 15.8l1.5-1.5M14.3 5.7l1.5-1.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import "../client/theme";
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in oklab, var(--paper) 88%, transparent);
  }

  /* A second hairline under the first: the ruled masthead of a notebook. */
  .site-header::after {
    content: "";
    position: absolute;
    inset: auto 0 -4px;
    border-bottom: 1px solid var(--rule);
    pointer-events: none;
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "brand nav tools";
    align-items: center;
    column-gap: var(--space-m);
    min-height: 4.25rem;
  }

  .brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand :global(.brand-seal) {
    transition: rotate 0.35s var(--ease-out);
  }

  .brand:hover :global(.brand-seal) {
    rotate: -6deg;
  }

  .brand-text {
    display: grid;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display-stack);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variation-settings:
      "SOFT" 50,
      "WONK" 1;
  }

  .brand-tagline {
    margin-top: 0.2rem;
    font-size: 0.625rem;
  }

  .nav {
    grid-area: nav;
    justify-self: end;
  }

  .nav ul {
    display: flex;
    gap: var(--space-3xs);
    padding: 0;
    list-style: none;
  }

  .nav a {
    position: relative;
    display: block;
    padding: 0.45rem 0.7rem;
    font-family: var(--font-mono-stack);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .nav a::after {
    content: "";
    position: absolute;
    inset: auto 0.7rem 0.2rem;
    height: 2px;
    background: var(--accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.25s var(--ease-out);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav a:hover::after,
  .nav a[aria-current]::after {
    scale: 1 1;
  }

  .nav a[aria-current] {
    color: var(--ink);
  }

  /* The language switch sits in the nav so the chrome reads as one list; a hairline
     separates it from the sections, and it never takes the active underline. */
  .nav .nav-lang {
    display: flex;
    align-items: center;
    margin-left: var(--space-2xs);
    padding-left: var(--space-s);
    border-left: 1px solid var(--rule);
  }

  .nav .nav-lang a {
    padding-inline: 0.5rem;
    color: var(--ink-muted);
  }

  .nav .nav-lang a::after {
    content: none;
  }

  .nav .nav-lang a:hover {
    color: var(--ink);
  }

  .tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    padding-left: var(--space-s);
    border-left: 1px solid var(--rule);
  }

  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--ink-soft);
    font-family: var(--font-mono-stack);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color 0.15s var(--ease-out),
      border-color 0.15s var(--ease-out),
      background-color 0.15s var(--ease-out);
  }

  .tool:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
    background: var(--paper-raised);
  }

  .search-trigger {
    border-color: var(--rule);
  }

  .search-kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    border: 1px solid var(--rule-strong);
    border-bottom-width: 2px;
    border-radius: 3px;
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  .lang-switch {
    font-size: 0.8rem;
  }

  .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  @media (max-width: 55.99rem) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand tools"
        "nav nav";
      min-height: 0;
      padding-top: var(--space-xs);
    }

    .tools {
      border-left: 0;
      padding-left: 0;
    }

    .nav {
      justify-self: stretch;
      margin-top: var(--space-2xs);
      margin-inline: -0.7rem;
    }

    .nav ul {
      justify-content: space-between;
    }

    .search-label,
    .search-kbd {
      display: none;
    }

    .search-trigger {
      border-color: transparent;
    }
  }

  /* Below this the tagline cannot fit on one line, and a wrapped one reads as broken. */
  @media (max-width: 27.99rem) {
    .brand-tagline {
      display: none;
    }
  }
</style>
