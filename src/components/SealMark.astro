---
import { FENG_PATH, SEAL_VIEWBOX } from "../lib/seal";

interface Props {
  size?: number | string;
  /** Accessible name; omit when the mark sits next to visible text. */
  label?: string;
  class?: string;
}

const { size = 28, label, class: className } = Astro.props;
const dimension = typeof size === "number" ? `${size}px` : size;
---

<svg
  class:list={["seal", className]}
  viewBox={SEAL_VIEWBOX}
  width={dimension}
  height={dimension}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <rect width="64" height="64" rx="9" fill="var(--seal-red, #b8321f)"></rect>
  <rect
    x="4.5"
    y="4.5"
    width="55"
    height="55"
    rx="5.5"
    fill="none"
    stroke="var(--seal-paper, #f4f1ea)"
    stroke-width="2"
  ></rect>
  <path fill="var(--seal-paper, #f4f1ea)" d={FENG_PATH}></path>
</svg>

<style>
  .seal {
    flex: none;
  }
</style>
