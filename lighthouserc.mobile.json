{
  "$comment": [
    "Mobile preset (lighthouse's default), the same URLs and thresholds as lighthouserc.json.",
    "On 2026-09-23 every URL scored perf 99-100 and 100 elsewhere, CLS 0, simulated LCP 1.80-1.95 s.",
    "The LCP margin is font bytes: Lantern counts every request that finishes before the observed",
    "paint, so a new face or an untrimmed font (see scripts/optimize-fonts.py) shows up here first.",
    "Three runs, because lhci asserts on the median and a shared CI runner is noisier than a laptop."
  ],
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4334/",
        "http://localhost:4334/zh/",
        "http://localhost:4334/2026/06/19/Designing-an-Operations-Heartbeat-System/",
        "http://localhost:4334/writing/",
        "http://localhost:4334/projects/",
        "http://localhost:4334/about/"
      ],
      "startServerCommand": "node scripts/serve-static.mjs --dist dist --port 4334",
      "startServerReadyPattern": "serve-static:",
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
      }
    }
  }
}
