{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @clean99/liquid-glass build && pnpm run prepare && next build && tsx scripts/post-export.ts",
    "clean": "rm -rf .next out coverage public",
    "dev": "next dev",
    "prepare": "tsx scripts/prepare-static-assets.ts && tsx scripts/generate-rss.ts && tsx scripts/generate-sitemap.ts && tsx scripts/generate-llms.ts",
    "lint": "eslint app lib scripts tests next.config.mjs vitest.config.ts",
    "test:components": "vitest run --passWithNoTests",
    "test:content": "tsx scripts/validate-content.ts",
    "test:routes": "tsx scripts/validate-routes.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clean99/liquid-glass": "workspace:*",
    "gray-matter": "^4.0.3",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-pretty-code": "^0.14.3",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
